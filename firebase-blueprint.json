{
  "entities": {
    "Bot": {
      "title": "Bot",
      "description": "Configuración y despliegue de bot de WhatsApp funcional para restaurantes",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "botName": { "type": "string" },
        "whatsappNumber": { "type": "string" },
        "metaPhoneId": { "type": "string" },
        "metaWabaId": { "type": "string" },
        "sedeId": { "type": "string" },
        "sedeName": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "deploying", "paused", "sandbox"] },
        "systemPrompt": { "type": "string" },
        "aiModel": { "type": "string" },
        "temperature": { "type": "number" },
        "currency": { "type": "string" },
        "paymentGateway": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "botName", "whatsappNumber", "status"]
    },
    "Branch": {
      "title": "Branch",
      "description": "Entidad y sede operativa del restaurante con geolocalización y menú",
      "type": "object",
      "properties": {
        "sede_id": { "type": "string" },
        "nombre_restaurante": { "type": "string" },
        "nombre_sede": { "type": "string" },
        "ciudad": { "type": "string" },
        "pais": { "type": "string" },
        "direccion": { "type": "string" },
        "telefono_whatsapp": { "type": "string" },
        "moneda": { "type": "string" },
        "costo_domicilio": { "type": "number" },
        "lat": { "type": "number" },
        "lng": { "type": "number" },
        "cobertura_km": { "type": "number" }
      },
      "required": ["sede_id", "nombre_sede", "ciudad", "moneda"]
    },
    "Order": {
      "title": "Order",
      "description": "Pedido de restaurante multicanal (WhatsApp, KDS, Delivery)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "pedido_id": { "type": "string" },
        "sede_id": { "type": "string" },
        "nombre_cliente": { "type": "string" },
        "telefono": { "type": "string" },
        "direccion_entrega": { "type": "string" },
        "estado": { "type": "string", "enum": ["creado", "esperando_pago", "pagado", "en_cocina", "listo_cocina", "en_camino", "entregado", "pago_rechazado", "cancelado", "anulado"] },
        "total": { "type": "number" },
        "moneda": { "type": "string" },
        "created_at": { "type": "string" }
      },
      "required": ["id", "sede_id", "telefono", "estado", "total", "moneda"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Perfil de usuario administrativo y credenciales de acceso al panel",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string", "enum": ["super_admin", "lead_devops", "branch_manager", "driver_fleet"] },
        "defaultSedeId": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "email", "name", "role"]
    },
    "KardexItem": {
      "title": "KardexItem",
      "description": "Item de inventario y stock de insumos con costeo automático",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "sede_id": { "type": "string" },
        "nombre_insumo": { "type": "string" },
        "categoria": { "type": "string" },
        "unidad_medida": { "type": "string" },
        "stock_actual": { "type": "number" },
        "stock_minimo": { "type": "number" },
        "costo_unitario": { "type": "number" },
        "valor_total_stock": { "type": "number" },
        "estado_stock": { "type": "string" }
      },
      "required": ["id", "sede_id", "nombre_insumo", "stock_actual"]
    },
    "Invoice": {
      "title": "Invoice",
      "description": "Factura o recibo con cálculo tributario, QR y soporte DIAN / IRS",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "invoiceNumber": { "type": "string" },
        "orderId": { "type": "string" },
        "sede_id": { "type": "string" },
        "cliente_nombre": { "type": "string" },
        "subtotal": { "type": "number" },
        "impuesto": { "type": "number" },
        "total": { "type": "number" },
        "moneda": { "type": "string" },
        "fecha": { "type": "string" }
      },
      "required": ["id", "invoiceNumber", "orderId", "total"]
    },
    "Customer": {
      "title": "Customer",
      "description": "Contacto CRM de cliente frecuente sincronizado con Google Contacts",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "address": { "type": "string" },
        "totalOrders": { "type": "number" },
        "totalSpent": { "type": "number" },
        "preferredBranch": { "type": "string" }
      },
      "required": ["id", "name", "phone"]
    },
    "AppSetting": {
      "title": "AppSetting",
      "description": "Configuraciones persistentes e integraciones API del sistema (Wompi, Stripe, Meta WABA, Drive)",
      "type": "object",
      "properties": {
        "key": { "type": "string" },
        "value": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["key", "updatedAt"]
    },
    "FcmToken": {
      "title": "FcmToken",
      "description": "Registro de tokens FCM para notificaciones push en segundo plano a administradores",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "token": { "type": "string" },
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "deviceType": { "type": "string" },
        "userAgent": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "enabledChannels": { "type": "string" }
      },
      "required": ["id", "token", "userId", "updatedAt"]
    },
    "NotificationLog": {
      "title": "NotificationLog",
      "description": "Registro histórico de alertas y notificaciones push enviadas por FCM a dispositivos",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "body": { "type": "string" },
        "type": { "type": "string" },
        "orderId": { "type": "string" },
        "sedeId": { "type": "string" },
        "status": { "type": "string" },
        "sentAt": { "type": "string" }
      },
      "required": ["id", "title", "body", "type", "sentAt"]
    }
  },
  "firestore": {
    "/bots/{botId}": {
      "schema": { "$ref": "#/entities/Bot" },
      "description": "Colección de bots desplegados y funcionales por número de WhatsApp"
    },
    "/branches/{branchId}": {
      "schema": { "$ref": "#/entities/Branch" },
      "description": "Colección de sedes operativas en USA y LATAM con sus menús y coordenadas"
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Colección de pedidos en tiempo real para KDS y WhatsApp"
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Usuarios y administradores del panel de control"
    },
    "/kardex_items/{kardexId}": {
      "schema": { "$ref": "#/entities/KardexItem" },
      "description": "Insumos, recetas y stock por sede"
    },
    "/invoices/{invoiceId}": {
      "schema": { "$ref": "#/entities/Invoice" },
      "description": "Facturas y recibos emitidos"
    },
    "/customers/{customerId}": {
      "schema": { "$ref": "#/entities/Customer" },
      "description": "Libreta de contactos CRM sincronizada con Google Contacts"
    },
    "/app_settings/{settingId}": {
      "schema": { "$ref": "#/entities/AppSetting" },
      "description": "Credenciales y configuraciones persistentes del restaurante"
    },
    "/fcm_tokens/{tokenId}": {
      "schema": { "$ref": "#/entities/FcmToken" },
      "description": "Tokens de registro FCM de dispositivos de administradores"
    },
    "/notification_logs/{logId}": {
      "schema": { "$ref": "#/entities/NotificationLog" },
      "description": "Historial de notificaciones push enviadas"
    }
  }
}
